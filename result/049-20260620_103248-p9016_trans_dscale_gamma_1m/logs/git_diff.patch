+float hk_blind_copytrack_accumulate_force(const struct hk_bmap *bmap, const fvec3_t *coords,
+										  fvec3_t *force, float unit, float lambda_copytrack,
+										  float *force_l1, int32_t *n_nonfinite)
+{
+	double total = 0.0, l1 = 0.0;
+	int32_t n_bad = 0;
+	int32_t i;
+	int a;
