+{
+	assert(set);
+	assert(bp);
+	assert(raw_id >= 0 && raw_id < set->n_raw);
+	assert(tmp_canonical_p4);
+	if (set->raw_p4) {
+		const float *raw_p4 = &set->raw_p4[(size_t)raw_id * HK_BLIND_N_STATE];
+		hk_blind_p4_from_raw_order(raw_p4, swapped, tmp_canonical_p4);
