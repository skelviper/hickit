+			continue;
+		}
+		if (power != 1.0f) {
+			double tmp[HK_BLIND_N_STATE];
+			double tmp_sum = 0.0;
+			for (s = 0; s < HK_BLIND_N_STATE; ++s) {
+				double pair_prob = (sum[idx][s] + (double)eps_count) / denom;
+				tmp[s] = power == 0.0f? 1.0 : pow(pair_prob, (double)power);
