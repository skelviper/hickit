+static void hk_blind_p4_from_raw_order(const float raw_p4[HK_BLIND_N_STATE], uint8_t swapped, float canonical_p4[HK_BLIND_N_STATE])
+{
+	assert(raw_p4);
+	assert(canonical_p4);
+	hk_blind_p4_to_raw_order(raw_p4, swapped, canonical_p4);
+}
